local function executa(codigo)
    coPrint("> " .. codigo, T.Hacker)
    local ok, err = pcall(function()
        local env = setmetatable({}, {__index = getfenv()})
        env.OBJ = State.alvo
        env.print = function(...)
            local p = {}
            for i = 1, select("#", ...) do p[i] = tostring(select(i, ...)) end
            coPrint(table.concat(p, " "), T.Hacker)
        end
        env.warn = function(...) coPrint("WARN: " .. table.concat({...}, " "), T.Alerta) end
        local fn = loadstring(codigo)
        if fn then
            setfenv(fn, env)
            local r = fn()
            if r ~= nil then coPrint("<- " .. tostring(r), T.Texto) end
        else coPrint("loadstring falhou", T.Erro) end
    end)
    if not ok then coPrint("ERRO: " .. tostring(err), T.Erro) end
end

entrada.FocusLost:Connect(function(enter)
    if enter and entrada.Text ~= "" then
        executa(entrada.Text)
        entrada.Text = ""
    end
end)

