local function monitorLoop()
    if not Monitor.ativo then return end
    if not State.alvo then return end
    local a = State.alvo
    local ok, valor = pcall(function() return a[Monitor.gatilhoProp] end)
    if not ok then return end
    if Monitor.ultimo[a] ~= valor then
        Monitor.ultimo[a] = valor
        monPrint("[MUDOU] " .. a.Name .. "." .. Monitor.gatilhoProp .. " = " .. tostring(valor), T.Texto)
        if tostring(valor) == tostring(Monitor.gatilhoValor) then
            monPrint(">>> GATILHO DISPARADO <<<", T.Alerta)
            if Monitor.autoTP and _G.ODD_Teleportar then
                local pos = a.Position or (a.CFrame and a.CFrame.Position)
                if pos then _G.ODD_Teleportar(CFrame.new(pos + Vector3.new(0, 4, 0)), a.Name) end
            end
            if Monitor.autoExec ~= "" then
                pcall(function()
                    local env = setmetatable({OBJ = a}, {__index = getfenv()})
                    local fn = loadstring(Monitor.autoExec)
                    if fn then setfenv(fn, env); fn() end
                end)
            end
        end
    end
end

botao(mn, "▸ INICIAR monitor do ALVO", function()
    if not State.alvo then monPrint("sem alvo", T.Erro); return end
    if Monitor.ativo then monPrint("[AVISO] já ativo", T.Alerta); return end
    Monitor.ativo = true
    Monitor.ultimo = {}
    Monitor.conn = RunService.Heartbeat:Connect(monitorLoop)
    monPrint(">>> MONITOR ATIVO <<<", T.Alerta)
    monPrint("alvo: " .. State.alvo:GetFullName(), T.Hacker)
    monPrint("prop: " .. Monitor.gatilhoProp, T.Hacker)
    monPrint("gatilho: " .. tostring(Monitor.gatilhoValor), T.Hacker)
end, T.Hacker).LayoutOrder = 2

botao(mn, "▸ PARAR monitor", function()
    Monitor.ativo = false
    if Monitor.conn then Monitor.conn:Disconnect(); Monitor.conn = nil end
    monPrint(">>> MONITOR PARADO <<<", T.Erro)
end, T.Erro).LayoutOrder = 3

