local function bypass()
    S.bypass=true
    bpP(">>> ATIVANDO CAMADAS <<<",C.AL)
    pcall(function() if setthreadidentity then setthreadidentity(8); bpP("[OK] identity=8",C.B) end end)
    pcall(function()
        for _,f in ipairs({"checkcaller","islclosure"}) do if _G[f] then _G[f]=function() return true end end end
        for _,f in ipairs({"getidentity","getthreadidentity"}) do if _G[f] then _G[f]=function() return 8 end end end
        bpP("[OK] funções falsificadas",C.B)
    end)
    pcall(function() LP.Kick=function() end; LP.ClearAllChildren=function() end; bpP("[OK] Kick bloqueado",C.B) end)
    pcall(function()
        local mt=getrawmetatable(game); local oldNC=mt.__namecall
        setreadonly(mt,false)
        mt.__namecall=newcclosure(function(self,...)
            local m=getnamecallmethod()
            if m=="Kick" or m=="Destroy" or m=="ClearAllChildren" then
                local s=tostring(self)
                if s:find("AntiCheat") or s:find("Byfron") or s:find("AC") or s:find("Log") then
                    bpP("[BLOCK] "..s..":"..m,C.ER)
                    return
                end
            end
            return oldNC(self,...)
        end)
        setreadonly(mt,true)
        bpP("[OK] namecall filtrado",C.B)
    end)
    pcall(function()
        local mt=getrawmetatable(game); local oldI=mt.__index
        setreadonly(mt,false)
        mt.__index=newcclosure(function(t,k)
            local r=oldI(t,k)
            if (k=="WalkSpeed" or k=="JumpPower") and t:IsA("Humanoid") then
                if type(r)=="number" and r>32 then return 16 end
            end
            return r
        end)
        setreadonly(mt,true)
        bpP("[OK] __index spoof (speed)",C.B)
    end)
    pcall(function()
        if hookfunction and getrawmetatable then
            local gm=getrawmetatable(game)
            local oldIdx=gm.__index
            setreadonly(gm,false)
            gm.__index=newcclosure(function(t,k)
                if k=="HttpGet" or k=="HttpGetAsync" or k=="HttpPost" then
                    return function() return "" end
                end
                return oldIdx(t,k)
            end)
            setreadonly(gm,true)
            bpP("[OK] HttpGet bloqueado",C.B)
        end
    end)
    pcall(function()
        for _,o in ipairs(game:GetDescendants()) do
            if o:IsA("Script") or o:IsA("LocalScript") then
                local nm=o.Name:lower()
                if nm:find("anticheat") or nm:find("detect") or nm:find("log") or nm:find("report") then
                    pcall(function() o.Disabled=true end)
                    bpP("[DISABLE] "..o:GetFullName(),C.AL)
                end
            end
        end
    end)
    bpP(">>> BYPASS COMPLETO <<<",C.AL)
end

