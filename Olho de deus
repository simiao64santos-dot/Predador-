-- ============================================================
-- PARENT SEGURO (resolve CoreGui bloqueado no mobile)
-- ============================================================
local _parent
do
    local ok, hui = pcall(function() return gethui() end)
    if ok and hui then
        _parent = hui
    else
        local ok2, core = pcall(function() return game:GetService("CoreGui") end)
        if ok2 and core then
            _parent = core
        else
            _parent = LocalPlayer:WaitForChild("PlayerGui")
        end
    end
end

-- remove UI antiga se existir
