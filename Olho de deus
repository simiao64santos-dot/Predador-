-- ============================================================
-- ESP (Drawing protegido por pcall)
-- ============================================================
local temDrawing = pcall(function() local d = Drawing.new("Square"); d:Remove() end)
local desenhos = {}

if temDrawing then
    local function limparESP(plr)
        local d = desenhos[plr]
        if not d then return end
        for _, v in pairs(d) do v:Remove() end
        desenhos[plr] = nil
    end

    local function criarESP()
        return {
            box    = Drawing.new("Square"),
            nome   = Drawing.new("Text"),
            dist   = Drawing.new("Text"),
            hp     = Drawing.new("Square"),
        }
    end

    RunService.RenderStepped:Connect(function()
        if not Cfg.ESP then
            for plr in pairs(desenhos) do limparESP(plr) end
            return
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr == LocalPlayer then continue end
            local char = plr.Character
            local head = char and char:FindFirstChild("Head")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            if not (head and hrp and hum and hum.Health > 0) then
                limparESP(plr); continue
            end
            if Cfg.ESPTeam and plr.Team == LocalPlayer.Team then
                limparESP(plr); continue
            end

            local d = desenhos[plr]
            if not d then d = criarESP(); desenhos[plr] = d end

            local hp, onScreen = Camera:WorldToViewportPoint(head.Position)
            local rp = Camera:WorldToViewportPoint(hrp.Position)
            if not onScreen then
                for _, v in pairs(d) do v.Visible = false end
                continue
            end

            local h = math.abs(rp.Y - hp.Y) * 1.8
            local w = h * 0.55

            if Cfg.ESPBox then
                d.box.Visible = true
                d.box.Size = Vector2.new(w, h)
                d.box.Position = Vector2.new(hp.X - w/2, hp.Y - h/2)
                d.box.Color = Tema.Borda
                d.box.Thickness = 1
            else d.box.Visible = false end

            if Cfg.ESPName then
                d.nome.Visible = true
                d.nome.Text = plr.Name
                d.nome.Size = 14
                d.nome.Center = true
                d.nome.Outline = true
                d.nome.Color = Tema.Borda
                d.nome.Position = Vector2.new(hp.X, hp.Y - h/2 - 16)
            else d.nome.Visible = false end

            if Cfg.ESPDist then
                d.dist.Visible = true
                d.dist.Text = math.floor((hrp.Position - Camera.CFrame.Position).Magnitude) .. "m"
                d.dist.Size = 12
                d.dist.Center = true
                d.dist.Outline = true
                d.dist.Color = Color3.new(1,1,1)
                d.dist.Position = Vector2.new(hp.X, hp.Y + h/2 + 2)
            else d.dist.Visible = false end

            if Cfg.ESPHealth then
                local pct = hum.Health / hum.MaxHealth
                d.hp.Visible = true
                d.hp.Size = Vector2.new(3, h * pct)
                d.hp.Position = Vector2.new(hp.X - w/2 - 6, hp.Y - h/2 + (h - h*pct))
                d.hp.Color = Color3.fromRGB(255*(1-pct), 255*pct, 0)
                d.hp.Filled = true
            else d.hp.Visible = false end
        end
    end)
end

-- ============================================================
-- AIMBOT (mobile: travamento automático)
-- ============================================================
RunService.RenderStepped:Connect(function()
    if not Cfg.Aimbot then return end
    local centro = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    local alvo, menorD = nil, Cfg.AimbotFOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local char = plr.Character
            local part = char and (char:FindFirstChild(Cfg.AimbotPart) or char:FindFirstChild("Head"))
            if part then
                if Cfg.AimbotWall then
                    local params = RaycastParams.new()
                    params.FilterType = Enum.RaycastFilterType.Exclude
                    params.FilterDescendantsInstances = {LocalPlayer.Character, part.Parent}
                    local hit = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, params)
                    if hit then continue end
                end
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - centro).Magnitude
                    if d < menorD then alvo, menorD = part, d end
                end
            end
        end
    end
    if alvo then
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, alvo.Position), Cfg.AimbotSmooth)
    end
end)

-- ============================================================
-- SPEED / JUMP / FLY LOOP
-- ============================================================
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if hum then
        hum.WalkSpeed = Cfg.SpeedOn and Cfg.SpeedVal or 16
        hum.JumpPower = Cfg.JumpOn and Cfg.JumpVal or 50
    end

    if Cfg.Fly and hrp then
        local bv = hrp:FindFirstChild("ODD_FlyBV")
        local bg = hrp:FindFirstChild("ODD_FlyBG")
        if bv and bg then
            local mov = Vector3.zero
            local cam = Camera.CFrame
            if UserInput:IsKeyDown(Enum.KeyCode.W) then mov += cam.LookVector end
            if UserInput:IsKeyDown(Enum.KeyCode.S) then mov -= cam.LookVector end
            if UserInput:IsKeyDown(Enum.KeyCode.A) then mov -= cam.RightVector end
            if UserInput:IsKeyDown(Enum.KeyCode.D) then mov += cam.RightVector end
            if UserInput:IsKeyDown(Enum.KeyCode.Space) then mov += Vector3.new(0,1,0) end
            bv.Velocity = mov * Cfg.FlySpeed
            bg.CFrame = cam
        end
    end
end)

