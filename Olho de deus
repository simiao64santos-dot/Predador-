local function novoToggle(pai, texto, valorInicial, callback)
    local holder = novoInst("Frame", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Tema.Painel,
        BorderSizePixel = 0,
        ZIndex = 6,
    }, pai)
    criarCorner(holder, 5)

    novoInst("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1,
        Text = texto,
        TextColor3 = Tema.Texto,
        TextSize = 13,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 7,
    }, holder)

    local estado = valorInicial
    local track = novoInst("Frame", {
        Size = UDim2.new(0, 46, 0, 22),
        Position = UDim2.new(1, -56, 0.5, -11),
        BackgroundColor3 = estado and Tema.Acerto or Tema.Fundo,
        BorderSizePixel = 0,
        ZIndex = 7,
    }, holder)
    criarCorner(track, 11)
    criarStroke(track, Tema.Borda, 1)

    local knob = novoInst("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = estado and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
        ZIndex = 8,
    }, track)
    criarCorner(knob, 9)

    local clicavel = novoInst("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 9,
    }, holder)

    clicavel.MouseButton1Click:Connect(function()
        estado = not estado
        TweenService:Create(track, TweenInfo.new(0.15), {
            BackgroundColor3 = estado and Tema.Acerto or Tema.Fundo
        }):Play()
        TweenService:Create(knob, TweenInfo.new(0.15), {
            Position = estado and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)
        }):Play()
        callback(estado)
    end)
    return holder
end

local function novoSlider(pai, texto, minV, maxV, valorInicial, callback)
    local holder = novoInst("Frame", {
        Size = UDim2.new(1, 0, 0, 52),
        BackgroundColor3 = Tema.Painel,
        BorderSizePixel = 0,
        ZIndex = 6,
    }, pai)
    criarCorner(holder, 5)

    local lbl = novoInst("TextLabel", {
        Size = UDim2.new(1, -20, 0, 20),
        Position = UDim2.new(0, 12, 0, 4),
        BackgroundTransparency = 1,
        Text = texto .. ": " .. tostring(valorInicial),
        TextColor3 = Tema.Texto,
        TextSize = 13,
        Font = Enum.Font.Code,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 7,
    }, holder)

    local track = novoInst("Frame", {
        Size = UDim2.new(1, -24, 0, 6),
        Position = UDim2.new(0, 12, 0, 36),
        BackgroundColor3 = Tema.Fundo,
        BorderSizePixel = 0,
        ZIndex = 7,
    }, holder)
    criarCorner(track, 3)

    local pct = (valorInicial - minV) / (maxV - minV)
    local fill = novoInst("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = Tema.Slider,
        BorderSizePixel = 0,
        ZIndex = 8,
    }, track)
    criarCorner(fill, 3)

    local dragging = false
    local clicavel = novoInst("TextButton", {
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        ZIndex = 9,
    }, track)

    local function atualizar(input)
        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(minV + (maxV - minV) * rel)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text = texto .. ": " .. tostring(val)
        callback(val)
    end

    clicavel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            atualizar(input)
        end
    end)
    UserInput.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            atualizar(input)
        end
    end)
    UserInput.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return holder
end

