RunService.RenderStepped:Connect(function()
    for _, plr in ipairs(Players:GetPlayers()) do
        updateESP(plr)
    end

    Scanner.refresh += 1
    if Scanner.refresh >= 60 then
        Scanner.refresh = 0
        if Config.ScannerOn then scanWorkspace() end
    end

    applySpeed()
    applyJump()
end)

