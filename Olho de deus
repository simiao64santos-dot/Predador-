local function bypassAtivar()
    State.bypassOn = true
    bpPrint(">>> ATIVANDO CAMADAS <<<", T.Alerta)

    pcall(function()
        if hookfunction and getrawmetatable then
            local gm = getrawmetatable(game)
            local oldIdx = gm.__index
            setreadonly(gm, false)
            gm.__index = newcclosure(function(t, k)
                return oldIdx(t, k)
            end)
            setreadonly(gm, true)
            bpPrint("[OK] metatable blindada", T.Hacker)
        else bpPrint("[SKIP] hookfunction indisponível", T.Dim) end
    end)

    pcall(function()
        if not getrawmetatable then error("sem mt") end
        local mt = getrawmetatable(game)
        local oldNC = mt.__namecall
        if not oldNC then return end
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            local metodo = getnamecallmethod()
            if metodo == "Kick" or metodo == "GetPropertyChangedSignal" then
                local sender = tostring(self)
                if sender:find("AntiCheat") or sender:find("Byfron") then
                    bpPrint("[BLOCK] " .. sender .. ":" .. metodo, T.Perigo)
                    return
                end
            end
            return oldNC(self, ...)
        end)
        setreadonly(mt, true)
        bpPrint("[OK] namecall filtrado", T.Hacker)
    end)

    pcall(function()
        if setthreadidentity then
            setthreadidentity(8)
            bpPrint("[OK] thread identity = 8", T.Hacker)
        else bpPrint("[SKIP] setthreadidentity indisponível", T.Dim) end
    end)

    pcall(function()
        local fns = {"getidentity","getthreadidentity","checkcaller","islclosure"}
        for _, f in ipairs(fns) do
            if _G[f] then
                local orig = _G[f]
                _G[f] = function(...)
                    if f == "checkcaller" or f == "islclosure" then return true end
                    if f == "getidentity" or f == "getthreadidentity" then return 8 end
                    return orig(...)
                end
            end
        end
        bpPrint("[OK] funções falsificadas", T.Hacker)
    end)

    bpPrint(">>> BYPASS ATIVO <<<", T.Alerta)
    statusHdr.Text = "● BYPASS"
    statusHdr.TextColor3 = T.Alerta
end

local function bypassDesativar()
    State.bypassOn = false
    bpPrint(">>> BYPASS DESATIVADO <<<", T.Erro)
    statusHdr.Text = "● ONLINE"
    statusHdr.TextColor3 = T.Hacker
end

