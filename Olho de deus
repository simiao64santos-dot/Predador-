local function novo(c, props, pai)
    local i = Instance.new(c)
    for k, v in pairs(props or {}) do i[k] = v end
    if pai then i.Parent = pai end
    return i
end
local function corner(p, r) return novo("UICorner", {CornerRadius = UDim.new(0, r or 5)}, p) end
local function stroke(p, c, t) return novo("UIStroke", {Color = c or T.Borda, Thickness = t or 1}, p) end

local function drag(frame, handle)
    handle = handle or frame
    local on, sp, spPos
    handle.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            on = true; sp = i.Position; spPos = frame.Position
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then on = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(i)
        if on and (i.UserInputType == Enum.UserInputType.MouseMovement
        or i.UserInputType == Enum.UserInputType.Touch) then
            local d = i.Position - sp
            frame.Position = UDim2.new(spPos.X.Scale, spPos.X.Offset + d.X,
                                       spPos.Y.Scale, spPos.Y.Offset + d.Y)
        end
    end)
end

