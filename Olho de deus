local function injetar(esc,label)
    injP(">>> INJ "..label.." <<<",C.AL)
    local conns={}
    local function watch(o)
        local c1=o.ChildAdded:Connect(function(x) injP("[+] "..o.Name.."/"..x.Name,C.B) end)
        local c2=o.ChildRemoved:Connect(function(x) injP("[-] "..o.Name.."/"..x.Name,C.ER) end)
        local c3=o.Changed:Connect(function(p) if p=="Position" or p=="CFrame" then return end; local ok,v=pcall(function() return o[p] end); injP("[~] "..o.Name.."."..p.."="..tostring(ok and v or "?"),C.TX) end)
        conns[#conns+1]=c1; conns[#conns+1]=c2; conns[#conns+1]=c3
    end
    watch(esc)
    for _,d in ipairs(esc:GetDescendants()) do watch(d) end
    S.hooks[#S.hooks+1]={nome=label,conns=conns}
    injP(">>> ATIVO ("..#conns.." hooks) <<<",C.AL)
end

