local function teleportar(cframe, label)
    local ok, err = pcall(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then error("sem HRP") end
        hrp.CFrame = cframe
        tpPrint("[TP] " .. (label or "destino"), T.Hacker)
    end)
    if not ok then tpPrint("[ERRO] " .. tostring(err), T.Erro) end
end

local function teleportarSuave(cframe, label)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then tpPrint("[ERRO] sem HRP", T.Erro); return end
    local startCF = hrp.CFrame
    local conn, t = nil, 0
    conn = RunService.Heartbeat:Connect(function(dt)
        t += dt * 2
        if t >= 1 then t = 1; conn:Disconnect() end
        pcall(function() hrp.CFrame = startCF:Lerp(cframe, t) end)
    end)
    tpPrint("[TP-SUAVE] " .. (label or "destino"), T.Hacker)
end

