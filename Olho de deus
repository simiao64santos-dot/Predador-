-- ============================================================
-- SCANNER INTELIGENTE
-- ============================================================
local Scanner = {
    targets = {},
    items = {},
    refresh = 0,
}

local function isAlive(plr)
    local char = plr.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

local function scanWorkspace()
    Scanner.targets = {}
    Scanner.items = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and isAlive(plr) then
            local char = plr.Character
            local hrp = char:FindFirstChild("HumanoidRootPart")
            if hrp then
                local dist = (hrp.Position - Camera.CFrame.Position).Magnitude
                if dist <= Config.ScannerRange then
                    table.insert(Scanner.targets, {
                        player = plr,
                        distance = dist,
                        root = hrp,
                    })
                end
            end
        end
    end

    -- itens coletáveis (heurística por nome)
    local namePatterns = {"Coin", "Gem", "Chest", "Money", "Cash", "Drop", "Loot", "Orb", "Crystal"}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            for _, pat in ipairs(namePatterns) do
                if string.find(obj.Name, pat, 1, true) then
                    table.insert(Scanner.items, obj)
                    break
                end
            end
        end
    end

    table.sort(Scanner.targets, function(a, b) return a.distance < b.distance end)
    StatusLabel:SetText(string.format("Scanner: %d alvos | %d itens", #Scanner.targets, #Scanner.items))
end

