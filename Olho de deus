-- TELEPORT
local tp=conts["TP"]
N("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder},tp)
N("UIPadding",{PaddingTop=UDim.new(0,2),PaddingLeft=UDim.new(0,2),PaddingRight=UDim.new(0,2)},tp)

local tpLog=term(tp,IS_MOB and 280 or 320)
tpLog.LayoutOrder=1
local tpOr=0
local function tpP(t,c) tpOr+=1; linha(tpLog,t,c or C.TX,tpOr); pcall(function() tpLog.CanvasPosition=Vector2.new(0,tpLog.AbsoluteCanvasSize.Y) end) end

local function tpTo(cf,label)
    local ok=pcall(function() local h=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart"); if h then h.CFrame=cf end end)
    if ok then tpP("[TP] "..(label or "ok"),C.B) end
end

btn(tp,"▸ TP → ALVO",function()
    if not S.alvo then return end
    local pos=S.alvo.Position or (S.alvo.CFrame and S.alvo.CFrame.Position)
    if pos then tpTo(CFrame.new(pos+Vector3.new(0,4,0)),S.alvo.Name) end
end,C.AL).LayoutOrder=2
btn(tp,"▸ TP → CHÃO",function() tpTo(CFrame.new(0,10,0),"origem") end,C.B).LayoutOrder=3
btn(tp,"▸ SALVAR posição",function()
    local h=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if h then _G.SAVED=h.CFrame; tpP("[SAVE] ok",C.B) end
end,C.B).LayoutOrder=4
btn(tp,"▸ VOLTAR posição",function() if _G.SAVED then tpTo(_G.SAVED,"salva") end end,C.B).LayoutOrder=5
btn(tp,"▸ DUP → Backpack",function()
    if not S.alvo or not S.alvo:IsA("Tool") then return end
    pcall(function() local b=LP:FindFirstChild("Backpack"); if b then local c=S.alvo:Clone(); c.Parent=b; tpP("[DUP] "..c.Name,C.B) end end)
end,C.AL).LayoutOrder=6

-- MONITOR
local mn=conts["MON"]
N("UIListLayout",{Padding=UDim.new(0,4),SortOrder=Enum.SortOrder.LayoutOrder},mn)
N("UIPadding",{PaddingTop=UDim.new(0,2),PaddingLeft=UDim.new(0,2),PaddingRight=UDim.new(0,2)},mn)

local mnLog=term(mn,IS_MOB and 320 or 360)
mnLog.LayoutOrder=1
local mnOr=0
local function mnP(t,c) mnOr+=1; linha(mnLog,t,c or C.TX,mnOr); pcall(function() mnLog.CanvasPosition=Vector2.new(0,mnLog.AbsoluteCanvasSize.Y) end) end

local Mon={ativo=false,conn=nil,ultimo={},prop="Transparency",val="0",autoTP=false}

btn(mn,"▸ INICIAR monitor",function()
    if not S.alvo then return end
    if Mon.ativo then return end
    Mon.ativo=true; Mon.ultimo={}
    Mon.conn=RunService.Heartbeat:Connect(function()
        if not Mon.ativo or not S.alvo then return end
        local ok,v=pcall(function() return S.alvo[Mon.prop] end)
        if not ok then return end
        if Mon.ultimo[S.alvo]~=v then
            Mon.ultimo[S.alvo]=v
            mnP("[~] "..Mon.prop.."="..tostring(v),C.TX)
            if tostring(v)==Mon.val then
                mnP(">>> GATILHO <<<",C.AL)
                if Mon.autoTP then
                    local pos=S.alvo.Position or (S.alvo.CFrame and S.alvo.CFrame.Position)
                    if pos then tpTo(CFrame.new(pos+Vector3.new(0,4,0)),S.alvo.Name) end
                end
            end
        end
    end)
    mnP(">>> ATIVO <<<",C.AL)
end,C.B).LayoutOrder=2
btn(mn,"▸ PARAR",function() Mon.ativo=false; if Mon.conn then Mon.conn:Disconnect(); Mon.conn=nil end; mnP(">>> OFF <<<",C.ER) end,C.ER).LayoutOrder=3
btn(mn,"▸ AUTO-TP on/off",function() Mon.autoTP=not Mon.autoTP; mnP("auto-TP="..tostring(Mon.autoTP),C.AL) end,C.AL).LayoutOrder=4

