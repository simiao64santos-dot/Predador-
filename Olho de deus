local function edPropriedade(nome, valorAtual, tipo)
    edOrdem += 1
    local row = novo("Frame", {
        Size = UDim2.new(1, -4, 0, 30), BackgroundColor3 = T.Painel2,
        BorderSizePixel = 0, LayoutOrder = edOrdem, ZIndex = 7,
    }, edScroll)
    corner(row, 4)

    novo("TextLabel", {
        Size = UDim2.new(0, 140, 1, 0), Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1, Text = nome, TextColor3 = T.Hacker,
        TextSize = 11, Font = Enum.Font.Code, TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 8, TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local input = novo("TextBox", {
        Size = UDim2.new(1, -150, 1, -6), Position = UDim2.new(0, 148, 0, 3),
        BackgroundColor3 = T.Painel, Text = tostring(valorAtual),
        TextColor3 = T.Texto, TextSize = 11, Font = Enum.Font.Code,
        BorderSizePixel = 0, ZIndex = 8, TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    }, row)
    corner(input, 3); stroke(input, T.BordaDim, 1)
    novo("UIPadding", {PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6)}, input)

    input.FocusLost:Connect(function()
        local v = input.Text
        local ok, err = pcall(function()
            if not State.alvo then return end
            local convertido
            if tipo == "number" then convertido = tonumber(v)
            elseif tipo == "boolean" then convertido = (v:lower() == "true" or v == "1")
            elseif tipo == "color" then
                local r, g, b = v:match("(%d+)[,%s]+(%d+)[,%s]+(%d+)")
                if r then convertido = Color3.fromRGB(tonumber(r), tonumber(g), tonumber(b)) end
            elseif tipo == "vector3" then
                local x, y, z = v:match("([%-%d%.]+)[,%s]+([%-%d%.]+)[,%s]+([%-%d%.]+)")
                if x then convertido = Vector3.new(tonumber(x), tonumber(y), tonumber(z)) end
            else convertido = v end
            if convertido ~= nil then State.alvo[nome] = convertido end
            logAdd("[EDIT] " .. nome .. " = " .. tostring(convertido), "info")
        end)
        if not ok then logAdd("[ERRO] " .. tostring(err), "erro") end
    end)
end

_G.ODD_RefreshEditor = function()
    if not State.alvo then
        alvoEd.Text = "> Alvo: (nenhum) — selecione no Scanner"
        return
    end
    alvoEd.Text = "> Alvo: " .. State.alvo.ClassName .. " :: " .. State.alvo:GetFullName()
    edClear()

    local props = {
        "Name","Transparency","Reflectance","CanCollide","Anchored","Massless",
        "Material","Color","Size","Position","Orientation","CFrame","Velocity",
        "WalkSpeed","JumpPower","Health","MaxHealth","Visible","Enabled",
        "Brightness","Range","Volume","Playing","Looped","Text","TextColor3",
        "TextSize","BackgroundColor3","BackgroundTransparency","Image",
        "Value","Amount","Duration",
    }
    for _, p in ipairs(props) do
        local ok, v = pcall(function() return State.alvo[p] end)
        if ok and v ~= nil then
            local tipo = type(v)
            if tipo == "number" then edPropriedade(p, v, "number")
            elseif tipo == "boolean" then edPropriedade(p, v, "boolean")
            elseif tipo == "string" then edPropriedade(p, v, "string")
            elseif tipo == "userdata" then
                local ts = tostring(v)
                if ts:find("Color3") then edPropriedade(p, ts, "color")
                elseif ts:find("Vector3") then edPropriedade(p, ts, "vector3") end
            end
        end
    end
end

