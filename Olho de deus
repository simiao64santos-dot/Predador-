local function serializa(obj, prof, maxD)
    prof = prof or 0
    maxD = maxD or 4
    if prof > maxD then return {class = obj.ClassName, name = obj.Name} end
    local d = {class = obj.ClassName, name = obj.Name, path = obj:GetFullName()}
    local filhos = {}
    for _, c in ipairs(obj:GetChildren()) do
        filhos[#filhos+1] = serializa(c, prof + 1, maxD)
    end
    if #filhos > 0 then d.children = filhos end
    return d
end

