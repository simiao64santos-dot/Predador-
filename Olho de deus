local function limpaResultados()
    for _, v in ipairs(resultadosScroll:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    ord = 0
end

local function scan(escopo, filtro, label)
    limpaResultados()
    local t0 = os.clock()
    local count = 0
    for _, obj in ipairs(escopo:GetDescendants()) do
        if not filtro or obj:IsA(filtro) then
            count += 1
            if count <= 400 then addResult(obj.Name, obj.ClassName, obj:GetFullName(), obj) end
        end
    end
    local dt = math.floor((os.clock() - t0) * 1000)
    infoLabel.Text = string.format("> %s :: %d objs (%dms)", label, count, dt)
    logAdd("[SCAN] " .. label .. " -> " .. count, "info")
end

