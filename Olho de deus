local function logAdd(msg, tipo)
    tipo = tipo or "info"
    local cor = T.Hacker
    if tipo == "erro" then cor = T.Erro
    elseif tipo == "alerta" then cor = T.Alerta
    elseif tipo == "dim" then cor = T.Dim
    elseif tipo == "perigo" then cor = T.Perigo end
    table.insert(State.historico, {texto = msg, cor = cor})
    if #State.historico > 500 then table.remove(State.historico, 1) end
end

