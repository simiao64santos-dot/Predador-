local function injetar(escopo, label)
    injPrint(">>> INJETANDO EM " .. label .. " <<<", T.Alerta)
    local conns = {}
    local function watch(obj)
        local c1 = obj.ChildAdded:Connect(function(ch)
            injPrint("  [+] " .. obj.Name .. "/" .. ch.Name, T.Hacker)
        end)
        local c2 = obj.ChildRemoved:Connect(function(ch)
            injPrint("  [-] " .. obj.Name .. "/" .. ch.Name, T.Erro)
        end)
        local c3 = obj.Changed:Connect(function(prop)
            if prop == "Position" or prop == "CFrame" or prop == "Orientation" then return end
            local ok, v = pcall(function() return obj[prop] end)
            injPrint("  [~] " .. obj.Name .. "." .. prop .. " = " .. tostring(ok and v or "?"), T.Texto)
        end)
        conns[#conns+1] = c1; conns[#conns+1] = c2; conns[#conns+1] = c3
    end
    watch(escopo)
    for _, d in ipairs(escopo:GetDescendants()) do watch(d) end
    State.hooks[#State.hooks+1] = {nome = label, conns = conns}
    injPrint(">>> ATIVO: " .. label .. " (" .. #conns .. " hooks) <<<", T.Alerta)
end

