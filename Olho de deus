local function configurarTapBotao(botao, callback)
    local tapInicio = 0
    local tapPos = nil
    local moveuTap = false
    local chamado = false

    botao.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            tapInicio = tick()
            tapPos = i.Position
            moveuTap = false
            chamado = false
        end
    end)

    botao.InputChanged:Connect(function(i)
        if tapPos and (i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local d = i.Position - tapPos
            if d.Magnitude > 10 then
                moveuTap = true
                botao.Position = UDim2.new(botao.Position.X.Scale, botao.Position.X.Offset + d.X, botao.Position.Y.Scale, botao.Position.Y.Offset + d.Y)
                tapPos = i.Position
            end
        end
    end)

    botao.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then
            if not moveuTap and (tick() - tapInicio) < 0.4 and not chamado then
                chamado = true
                pcall(callback)
            end
            tapPos = nil
            moveuTap = false
        end
    end)
end

